{
  "archinstall-language": "English",
  "audio_config": {
    "audio": "pipewire"
  },
  "bootloader_config": {
    "bootloader": "Systemd-boot",
    "uki": false
  },
  "debug": false,
  "disk_config": {
    "config_type": "default_layout",
    "device_modifications": [
      {
        "device": "/dev/nvme0n1",
        "partitions": [
          {
            "flags": ["boot"],
            "fs_type": "fat32",
            "size": {
              "unit": "MiB",
              "value": 512
            },
            "mount_options": [],
            "mountpoint": "/boot",
            "status": "create",
            "type": "primary"
          },
          {
            "btrfs": [
              {"name": "@", "mountpoint": "/"},
              {"name": "@home", "mountpoint": "/home"},
              {"name": "@snapshots", "mountpoint": "/.snapshots"},
              {"name": "@log", "mountpoint": "/var/log"},
              {"name": "@cache", "mountpoint": "/var/cache"}
            ],
            "flags": [],
            "fs_type": "btrfs",
            "size": {
              "unit": "Percentage",
              "value": 100
            },
            "mount_options": ["compress=zstd", "noatime"],
            "mountpoint": "/",
            "status": "create",
            "type": "primary"
          }
        ]
      }
    ]
  },
  "hostname": "archlinux",
  "kernels": ["linux-zen"],
  "locale_config": {
    "kb_layout": "us",
    "sys_enc": "UTF-8",
    "sys_lang": "en_US.UTF-8"
  },
  "mirror_config": {
    "custom_repositories": [
      {
        "name": "archlinuxcn",
        "url": "https://mirrors.ustc.edu.cn/archlinuxcn/$arch",
        "sign_check": "Required",
        "sign_option": "TrustAll"
      }
    ],
    "optional_repositories": ["multilib"]
  },
  "network_config": {
    "type": "nm"
  },
  "no_pkg_lookups": false,
  "ntp": true,
  "offline": false,
  "packages": [
    "base-devel",
    "vim",
    "git",
    "amd-ucode",
    "btrfs-progs",
    "ntfs-3g",
    "mesa",
    "vulkan-radeon",
    "lib32-mesa",
    "lib32-vulkan-radeon",
    "firefox",
    "firefox-i18n-zh-cn",
    "noto-fonts-cjk",
    "fcitx5",
    "fcitx5-configtool",
    "fcitx5-chinese-addons",
    "fcitx5-gtk",
    "fcitx5-qt",
    "mpv",
    "unzip",
    "unrar",
    "p7zip",
    "ufw",
    "zram-generator",
    "bluez",
    "bluez-utils",
    "kde-connect",
    "steam",
    "kde-system",
    "konsole",
    "ark",
    "kate",
    "kcalc",
    "filelight",
    "gwenview",
    "okular",
    "ffmpegthumbs",
    "kio-extras",
    "libreoffice-fresh",
    "libreoffice-fresh-zh-cn",
    "archlinuxcn-keyring",
    "paru"
  ],
  "parallel downloads": 5,
  "profile_config": {
    "gfx_driver": "All open-source (default)",
    "greeter": "sddm",
    "profile": {
      "details": ["KDE Plasma"],
      "main": "Desktop"
    }
  },
  "script": "guided",
  "services": ["bluetooth", "ufw"],
  "silent": false,
  "swap": {
    "enabled": true,
    "algorithm": "zstd"
  },
  "timezone": "Asia/Shanghai",
  "version": "2.8.6"
}
